local miniDragging = false
local miniDragInput = nil
local miniDragStart = nil
local miniStartPos = nil
local miniMoved = false

local function updateMiniDrag(input)
    local delta = input.Position - miniDragStart
    if math.abs(delta.X) > 3 or math.abs(delta.Y) > 3 then
        miniMoved = true
    end

    miniOpenButton.Position = UDim2.new(
        miniStartPos.X.Scale,
        miniStartPos.X.Offset + delta.X,
        miniStartPos.Y.Scale,
        miniStartPos.Y.Offset + delta.Y
    )
end

miniOpenButton.InputBegan:Connect(function(input)
    if isPressInput(input) then
        miniDragging = true
        miniMoved = false
        miniDragStart = input.Position
        miniStartPos = miniOpenButton.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                miniDragging = false
            end
        end)
    end
end)

miniOpenButton.InputChanged:Connect(function(input)
    if isMoveInput(input) then
        miniDragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == miniDragInput and miniDragging then
        updateMiniDrag(input)
    end
end)

-- Helpers
local function getRoot()
    local character = player.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local character = player.Character
    if not character then return nil end
    return character:FindFirstChildOfClass("Humanoid")
end

local function isNPC(model)
    if not model or not model:IsA("Model") then return false end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso")

    if not humanoid or not root then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    if player.Character and model == player.Character then return false end

    return true
end

-- Performance cache: jangan scan Workspace:GetDescendants() setiap frame
local NPC_CACHE = {}
local LAST_NPC_SCAN = 0
local NPC_SCAN_INTERVAL = 1.25

local function refreshNPCCache()
    NPC_CACHE = {}

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and isNPC(obj) then
            table.insert(NPC_CACHE, obj)
        end
    end

    LAST_NPC_SCAN = tick()
end

local function getAllNPCs(forceRefresh)
    if forceRefresh or tick() - LAST_NPC_SCAN >= NPC_SCAN_INTERVAL then
        refreshNPCCache()
    end

    return NPC_CACHE
end

local function getPart(model, ...)
    local names = {...}

    for _, name in ipairs(names) do
        local part = model:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            return part
        end
    end

    return nil
end

local function getNPCHead(model)
    return getPart(model, "Head")
        or getPart(model, "HumanoidRootPart")
        or getPart(model, "Torso")
        or getPart(model, "UpperTorso")
end

local function getAdorneeFromPrompt(prompt)
    local parent = prompt.Parent

    if parent and parent:IsA("BasePart") then
        return parent
    end

    local model = parent and parent:FindFirstAncestorOfClass("Model")
    if model then
        if model.PrimaryPart then
            return model.PrimaryPart
        end

        local part = model:FindFirstChildWhichIsA("BasePart", true)
        if part then
            return part
        end
    end

    return nil
end

local function isOpenChestPrompt(prompt)
    if not prompt:IsA("ProximityPrompt") then
        return false
    end

    local action = string.lower(prompt.ActionText or "")
    local object = string.lower(prompt.ObjectText or "")
    local name = string.lower(prompt.Name or "")

    return action == "open chest"
        or object == "open chest"
        or name == "open chest"
        or string.find(action, "open chest") ~= nil
        or string.find(object, "open chest") ~= nil
        or string.find(name, "open chest") ~= nil
end

-- Noclip
local NoclipConnection = nil
local NoclipEnabled = false

local function noclip()
    NoclipEnabled = true

    if NoclipConnection then
        NoclipConnection:Disconnect()
        NoclipConnection = nil
    end

    NoclipConnection = RunService.Stepped:Connect(function()
        local character = player.Character

        if NoclipEnabled and character then
            for _, v in pairs(character:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.CanCollide = false
                end
            end
        end
    end)
end

local function clip()
    NoclipEnabled = false

    if NoclipConnection then
        NoclipConnection:Disconnect()
        NoclipConnection = nil
    end

    local character = player.Character
    if character then
        for _, v in pairs(character:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = true
            end
        end
    end
end

-- Instant Interact
local PromptEnabled = false
local PromptConnection = nil
local SavedPrompts = {}

local function savePrompt(prompt)
    if prompt:IsA("ProximityPrompt") and not SavedPrompts[prompt] then
        SavedPrompts[prompt] = {
            HoldDuration = prompt.HoldDuration
        }
    end
end

local function applyInstantPrompt(prompt)
    if prompt:IsA("ProximityPrompt") then
        savePrompt(prompt)
        prompt.HoldDuration = 0
    end
end

local function enableInstantPrompt()
    PromptEnabled = true

    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            applyInstantPrompt(v)
        end
    end

    if PromptConnection then
        PromptConnection:Disconnect()
        PromptConnection = nil
    end

    PromptConnection = Workspace.DescendantAdded:Connect(function(v)
        if PromptEnabled and v:IsA("ProximityPrompt") then
            task.wait(0.1)
            applyInstantPrompt(v)
        end
    end)
end

local function disableInstantPrompt()
    PromptEnabled = false

    if PromptConnection then
        PromptConnection:Disconnect()
        PromptConnection = nil
    end

    for prompt, data in pairs(SavedPrompts) do
        if prompt and prompt.Parent then
            prompt.HoldDuration = data.HoldDuration
        end
    end
end

-- Fly
local FlyEnabled = false
local FlySpeed = 50
local FlyConnection = nil
local BodyVelocity = nil
local BodyGyro = nil

local flyingKeys = {
    W = false,
    A = false,
    S = false,
    D = false,
    Space = false,
    LeftControl = false
}

local function startFly()
    FlyEnabled = true

    local root = getRoot()
    local humanoid = getHumanoid()

    if not root or not humanoid then
        return
    end

    humanoid.PlatformStand = true

    if mobileFlyFrame then
        mobileFlyFrame.Visible = UserInputService.TouchEnabled
    end

    if BodyVelocity then BodyVelocity:Destroy() end
    if BodyGyro then BodyGyro:Destroy() end

    BodyVelocity = Instance.new("BodyVelocity")
    BodyVelocity.Name = "CihuyFlyVelocity"
    BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    BodyVelocity.Velocity = Vector3.new(0, 0, 0)
    BodyVelocity.Parent = root

    BodyGyro = Instance.new("BodyGyro")
    BodyGyro.Name = "CihuyFlyGyro"
    BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    BodyGyro.P = 9000
    BodyGyro.CFrame = root.CFrame
    BodyGyro.Parent = root

    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end

    FlyConnection = RunService.RenderStepped:Connect(function()
        local currentRoot = getRoot()
        local currentHumanoid = getHumanoid()
        local cam = Workspace.CurrentCamera

        if not FlyEnabled or not currentRoot or not currentHumanoid or not cam then
            return
        end

        currentHumanoid.PlatformStand = true

        local moveDirection = Vector3.new(0, 0, 0)

        -- PC keyboard movement
        if flyingKeys.W then moveDirection = moveDirection + cam.CFrame.LookVector end
        if flyingKeys.S then moveDirection = moveDirection - cam.CFrame.LookVector end
        if flyingKeys.A then moveDirection = moveDirection - cam.CFrame.RightVector end
        if flyingKeys.D then moveDirection = moveDirection + cam.CFrame.RightVector end
        if flyingKeys.Space then moveDirection = moveDirection + Vector3.new(0, 1, 0) end
        if flyingKeys.LeftControl then moveDirection = moveDirection - Vector3.new(0, 1, 0) end

        -- Mobile analog movement
        -- Humanoid.MoveDirection otomatis membaca analog HP, jadi fly bisa maju/mundur/kiri/kanan lewat analog.
        if currentHumanoid.MoveDirection.Magnitude > 0 then
            moveDirection = moveDirection + currentHumanoid.MoveDirection
        end

        -- Mobile vertical movement pakai tombol UP / DOWN kecil.
        if MobileFlyUp then moveDirection = moveDirection + Vector3.new(0, 1, 0) end
        if MobileFlyDown then moveDirection = moveDirection - Vector3.new(0, 1, 0) end

        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit * FlySpeed
        end

        if BodyVelocity then
            BodyVelocity.Velocity = moveDirection
        end

        if BodyGyro then
            BodyGyro.CFrame = cam.CFrame
        end
    end)
end

local function stopFly()
    FlyEnabled = false
    MobileFlyUp = false
    MobileFlyDown = false

    if mobileFlyFrame then
        mobileFlyFrame.Visible = false
    end

    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end

    if BodyVelocity then
        BodyVelocity:Destroy()
        BodyVelocity = nil
    end

    if BodyGyro then
        BodyGyro:Destroy()
        BodyGyro = nil
    end

    local humanoid = getHumanoid()
    if humanoid then
        humanoid.PlatformStand = false
    end
end

-- Name + Health ESP
local NameESPEnabled = false
local HealthESPEnabled = false
local BillboardConnection = nil
local BillboardLoopRunning = false
local BillboardESPs = {}

local function createNPCBillboard(model)
    if BillboardESPs[model] then
        return BillboardESPs[model]
    end

    local head = getNPCHead(model)
    if not head then return nil end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "CihuyNPCESP"
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 200, 0, 60)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = CoreGui

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "NameLabel"
    nameLabel.Size = UDim2.new(1, 0, 0, 25)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = model.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextSize = 14
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Visible = false
    nameLabel.Parent = billboard

    local healthLabel = Instance.new("TextLabel")
    healthLabel.Name = "HealthLabel"
    healthLabel.Size = UDim2.new(1, 0, 0, 25)
    healthLabel.Position = UDim2.new(0, 0, 0, 22)
    healthLabel.BackgroundTransparency = 1
    healthLabel.Text = "HP: ?"
    healthLabel.TextColor3 = Color3.fromRGB(80, 255, 120)
    healthLabel.TextStrokeTransparency = 0
    healthLabel.TextSize = 14
    healthLabel.Font = Enum.Font.GothamBold
    healthLabel.Visible = false
    healthLabel.Parent = billboard

    BillboardESPs[model] = billboard
    return billboard
end

local function clearBillboardESPs()
    for _, billboard in pairs(BillboardESPs) do
        if billboard then
            billboard:Destroy()
        end
    end
    BillboardESPs = {}
end

local function updateBillboardESP()
    for _, npc in ipairs(getAllNPCs()) do
        local humanoid = npc:FindFirstChildOfClass("Humanoid")
        local billboard = createNPCBillboard(npc)

        if billboard and humanoid then
            local nameLabel = billboard:FindFirstChild("NameLabel")
            local healthLabel = billboard:FindFirstChild("HealthLabel")

            if nameLabel then
                nameLabel.Text = npc.Name
                nameLabel.Visible = NameESPEnabled
            end

            if healthLabel then
                healthLabel.Text = "HP: " .. math.floor(humanoid.Health) .. " / " .. math.floor(humanoid.MaxHealth)
                healthLabel.Visible = HealthESPEnabled
            end

            billboard.Enabled = NameESPEnabled or HealthESPEnabled
        end
    end

    for model, billboard in pairs(BillboardESPs) do
        if not model or not model.Parent or not isNPC(model) then
            if billboard then billboard:Destroy() end
            BillboardESPs[model] = nil
        end
    end
end

local function startBillboardLoop()
    if BillboardLoopRunning then
        return
    end

    BillboardLoopRunning = true

    task.spawn(function()
        while NameESPEnabled or HealthESPEnabled do
            updateBillboardESP()
            task.wait(0.35)
        end

        BillboardLoopRunning = false
    end)
end

local function stopBillboardLoopIfUnused()
    if not NameESPEnabled and not HealthESPEnabled then
        if BillboardConnection then
            BillboardConnection:Disconnect()
            BillboardConnection = nil
        end
        clearBillboardESPs()
    end
end

-- Chest ESP
local ChestESPEnabled = false
local ChestESPMaxStud = 1000
local ChestConnection = nil
local ChestESPs = {}
local ChestPromptCache = {}
local LastChestPromptScan = 0
local ChestPromptScanInterval = 1.5

local function getDistanceFromPlayer(part)
    local root = getRoot()
    if not root or not part then
        return math.huge
    end
    return (part.Position - root.Position).Magnitude
end

local function createChestESP(prompt)
    local adornee = getAdorneeFromPrompt(prompt)
    if not adornee then return end

    if ChestESPs[prompt] then
        return
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "CihuyChestESP"
    billboard.Adornee = adornee
    billboard.Size = UDim2.new(0, 140, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = CoreGui

    local label = Instance.new("TextLabel")
    label.Name = "ChestLabel"
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = "Chest\n0 studs"
    label.TextColor3 = Color3.fromRGB(255, 220, 80)
    label.TextStrokeTransparency = 0
    label.TextSize = 16
    label.Font = Enum.Font.GothamBold
    label.Parent = billboard

    ChestESPs[prompt] = {
        Billboard = billboard,
        Label = label,
        Adornee = adornee
    }
end

local function refreshChestPromptCache()
    ChestPromptCache = {}

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and isOpenChestPrompt(obj) then
            table.insert(ChestPromptCache, obj)
        end
    end

    LastChestPromptScan = tick()
end

local function updateChestESP()
    if tick() - LastChestPromptScan >= ChestPromptScanInterval then
        refreshChestPromptCache()
    end

    for _, obj in ipairs(ChestPromptCache) do
        if obj and obj.Parent and isOpenChestPrompt(obj) then
            local adornee = getAdorneeFromPrompt(obj)

            if adornee then
                local distance = getDistanceFromPlayer(adornee)

                if distance <= ChestESPMaxStud then
                    createChestESP(obj)
                end
            end
        end
    end

    for prompt, data in pairs(ChestESPs) do
        local remove = false

        if not prompt or not prompt.Parent or not isOpenChestPrompt(prompt) then
            remove = true
        elseif not data.Adornee or not data.Adornee.Parent then
            remove = true
        else
            local distance = getDistanceFromPlayer(data.Adornee)

            if distance > ChestESPMaxStud then
                data.Billboard.Enabled = false
            else
                data.Billboard.Enabled = true
                data.Label.Text = "Chest\n" .. tostring(math.floor(distance)) .. " studs"
            end
        end

        if remove then
            if data.Billboard then
                data.Billboard:Destroy()
            end
            ChestESPs[prompt] = nil
        end
    end
end

local function startChestESP()
    ChestESPEnabled = true
    updateChestESP()

    if ChestConnection then
        ChestConnection:Disconnect()
        ChestConnection = nil
    end

    task.spawn(function()
        while ChestESPEnabled do
            updateChestESP()
            task.wait(0.45)
        end
    end)
end

local function stopChestESP()
    ChestESPEnabled = false

    if ChestConnection then
        ChestConnection:Disconnect()
        ChestConnection = nil
    end

    for _, data in pairs(ChestESPs) do
        if data.Billboard then
            data.Billboard:Destroy()
        end
    end

    ChestESPs = {}
end


-- Combat / Auto Kill Closest
local AutoKillEnabled = false
local AutoKillRadius = 7
local AutoKillConnection = nil
local LastCombatSwing = 0
local LastCombatTargetScan = 0
local LastCombatEquip = 0
local CurrentCombatTargetRoot = nil
local FollowBelowDistanceNPC = 10
local NoTargetUpStud = 10
local HadCombatTarget = false
local CombatToolNames = {"Hatchet", "Machete"}

local function findCombatTool()
    local character = player.Character
    local backpack = player:FindFirstChildOfClass("Backpack")

    for _, toolName in ipairs(CombatToolNames) do
        if character then
            local tool = character:FindFirstChild(toolName)
            if tool and tool:IsA("Tool") then
                return tool
            end
        end

        if backpack then
            local tool = backpack:FindFirstChild(toolName)
            if tool and tool:IsA("Tool") then
                return tool
            end
        end
    end

    return nil
end

local function equipCombatTool()
    local character = player.Character
    local humanoid = getHumanoid()
    local tool = findCombatTool()

    if humanoid and tool and tool.Parent ~= character then
        pcall(function()
            humanoid:EquipTool(tool)
        end)
    end

    return findCombatTool()
end

local function getNPCRoot(model)
    if not model then return nil end
    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("UpperTorso")
        or model.PrimaryPart
end

local function isAnchoredNPC(npc, npcRoot)
    if npcRoot and npcRoot:IsA("BasePart") and npcRoot.Anchored then
        return true
    end

    if npc and npc.PrimaryPart and npc.PrimaryPart:IsA("BasePart") and npc.PrimaryPart.Anchored then
        return true
    end

    local mainParts = {
        "HumanoidRootPart",
        "Torso",
        "UpperTorso",
        "LowerTorso"
    }

    for _, partName in ipairs(mainParts) do
        local part = npc and npc:FindFirstChild(partName)
        if part and part:IsA("BasePart") and part.Anchored then
            return true
        end
    end

    return false
end

local function getClosestNPCInRadius(radius)
    local root = getRoot()
    if not root then return nil, nil end

    local closestNPC = nil
    local closestRoot = nil
    local closestDistance = radius

    for _, npc in ipairs(getAllNPCs()) do
        local humanoid = npc:FindFirstChildOfClass("Humanoid")
        local npcRoot = getNPCRoot(npc)

        -- NPC yang Anchored tidak ditarget supaya auto kill tidak nyangkut/lag
        if humanoid and humanoid.Health > 0 and npcRoot and not isAnchoredNPC(npc, npcRoot) then
            local distance = (npcRoot.Position - root.Position).Magnitude

            if distance <= closestDistance then
                closestDistance = distance
                closestNPC = npc
                closestRoot = npcRoot
            end
        end
    end

    return closestNPC, closestRoot
end

local function followBelowNPC(npcRoot)
    local root = getRoot()
    if not root or not npcRoot then return end

    local belowPosition = npcRoot.Position - Vector3.new(0, FollowBelowDistanceNPC, 0)

    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    root.CFrame = CFrame.new(belowPosition, npcRoot.Position)
end

local function teleportUpWhenNoTarget()
    local root = getRoot()
    if not root then return end

    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    root.CFrame = root.CFrame + Vector3.new(0, NoTargetUpStud, 0)
end

local function startAutoKillClosest()
    AutoKillEnabled = true

    if AutoKillConnection then
        AutoKillConnection:Disconnect()
        AutoKillConnection = nil
    end

    AutoKillConnection = RunService.Heartbeat:Connect(function()
        if not AutoKillEnabled then return end

        local now = tick()

        -- scan target tidak setiap frame supaya tidak ngelag
        if now - LastCombatTargetScan >= 0.25 then
            LastCombatTargetScan = now
            local _, npcRoot = getClosestNPCInRadius(AutoKillRadius)
            CurrentCombatTargetRoot = npcRoot
        end

        if CurrentCombatTargetRoot and CurrentCombatTargetRoot.Parent then
            HadCombatTarget = true
            followBelowNPC(CurrentCombatTargetRoot)

            local tool = findCombatTool()

            -- equip tool cukup beberapa kali per detik, bukan tiap frame
            if now - LastCombatEquip >= 0.6 then
                LastCombatEquip = now
                tool = equipCombatTool()
            end

            -- attack rate dibatasi biar FPS tidak drop
            if tool and now - LastCombatSwing >= 0.35 then
                LastCombatSwing = now
                pcall(function()
                    tool:Activate()
                end)
            end
        else
            -- kalau sebelumnya ada target lalu sekarang sudah tidak ada NPC terdeteksi, naik 10 stud sekali saja
            if HadCombatTarget then
                HadCombatTarget = false
                teleportUpWhenNoTarget()
            end
        end
    end)
end

local function stopAutoKillClosest()
    AutoKillEnabled = false
    HadCombatTarget = false

    if AutoKillConnection then
        AutoKillConnection:Disconnect()
        AutoKillConnection = nil
    end
end

-- Skeleton ESP
local SkeletonESPEnabled = false
local SkeletonConnection = nil
local SkeletonLines = {}

local function newLine()
    if not Drawing then
        return nil
    end

    local line = Drawing.new("Line")
    line.Visible = false
    line.Thickness = 2
    line.Transparency = 1
    line.Color = Color3.fromRGB(255, 255, 255)
    return line
end

local function clearSkeletonLines()
    for _, line in ipairs(SkeletonLines) do
        pcall(function()
            line:Remove()
        end)
    end
    SkeletonLines = {}
end

local function getLine(index)
    if not SkeletonLines[index] then
        SkeletonLines[index] = newLine()
    end
    return SkeletonLines[index]
end

local function getSkeletonPairs(model)
    local head = getPart(model, "Head")
    local upperTorso = getPart(model, "UpperTorso", "Torso")
    local lowerTorso = getPart(model, "LowerTorso", "Torso")

    local leftUpperArm = getPart(model, "LeftUpperArm", "Left Arm")
    local leftLowerArm = getPart(model, "LeftLowerArm", "Left Arm")
    local leftHand = getPart(model, "LeftHand", "Left Arm")

    local rightUpperArm = getPart(model, "RightUpperArm", "Right Arm")
    local rightLowerArm = getPart(model, "RightLowerArm", "Right Arm")
    local rightHand = getPart(model, "RightHand", "Right Arm")

    local leftUpperLeg = getPart(model, "LeftUpperLeg", "Left Leg")
    local leftLowerLeg = getPart(model, "LeftLowerLeg", "Left Leg")
    local leftFoot = getPart(model, "LeftFoot", "Left Leg")

    local rightUpperLeg = getPart(model, "RightUpperLeg", "Right Leg")
    local rightLowerLeg = getPart(model, "RightLowerLeg", "Right Leg")
    local rightFoot = getPart(model, "RightFoot", "Right Leg")

    return {
        {head, upperTorso},
        {upperTorso, lowerTorso},

        {upperTorso, leftUpperArm},
        {leftUpperArm, leftLowerArm},
        {leftLowerArm, leftHand},

        {upperTorso, rightUpperArm},
        {rightUpperArm, rightLowerArm},
        {rightLowerArm, rightHand},

        {lowerTorso, leftUpperLeg},
        {leftUpperLeg, leftLowerLeg},
        {leftLowerLeg, leftFoot},

        {lowerTorso, rightUpperLeg},
        {rightUpperLeg, rightLowerLeg},
        {rightLowerLeg, rightFoot}
    }
end

local function startSkeletonESP()
    SkeletonESPEnabled = true

    if not Drawing then
        skeletonButton.Text = "Skeleton: No Drawing"
        task.wait(1)
        skeletonButton.Text = "Skeleton ESP: OFF"
        SkeletonESPEnabled = false
        return
    end

    if SkeletonConnection then
        SkeletonConnection:Disconnect()
        SkeletonConnection = nil
    end

    local lastSkeletonUpdate = 0
    local skeletonUpdateInterval = 1 / 15
    local skeletonMaxNPC = 8
    local skeletonMaxDistance = 250

    SkeletonConnection = RunService.RenderStepped:Connect(function()
        if tick() - lastSkeletonUpdate < skeletonUpdateInterval then
            return
        end
        lastSkeletonUpdate = tick()

        local cam = Workspace.CurrentCamera
        local root = getRoot()
        if not cam or not root then return end

        local lineIndex = 1
        local npcCount = 0

        for _, npc in ipairs(getAllNPCs()) do
            if npcCount >= skeletonMaxNPC then
                break
            end

            local humanoid = npc:FindFirstChildOfClass("Humanoid")
            local npcRoot = getNPCRoot(npc)

            if humanoid and humanoid.Health > 0 and npcRoot and (npcRoot.Position - root.Position).Magnitude <= skeletonMaxDistance then
                npcCount = npcCount + 1

                for _, pairData in ipairs(getSkeletonPairs(npc)) do
                    local partA = pairData[1]
                    local partB = pairData[2]

                    if partA and partB then
                        local posA, onScreenA = cam:WorldToViewportPoint(partA.Position)
                        local posB, onScreenB = cam:WorldToViewportPoint(partB.Position)

                        local line = getLine(lineIndex)

                        if line then
                            if onScreenA and onScreenB then
                                line.From = Vector2.new(posA.X, posA.Y)
                                line.To = Vector2.new(posB.X, posB.Y)
                                line.Visible = true
                            else
                                line.Visible = false
                            end
                        end

                        lineIndex = lineIndex + 1
                    end
                end
            end
        end

        for i = lineIndex, #SkeletonLines do
            if SkeletonLines[i] then
                SkeletonLines[i].Visible = false
            end
        end
    end)
end

local function stopSkeletonESP()
    SkeletonESPEnabled = false

    if SkeletonConnection then
        SkeletonConnection:Disconnect()
        SkeletonConnection = nil
    end

    clearSkeletonLines()
end


-- Teleport
local RaftCFrame = CFrame.new(257, 154, -256)

local function flashButtonText(button, text, resetText)
    local oldText = resetText or button.Text
    button.Text = text
    task.delay(1, function()
        if button and button.Parent then
            button.Text = oldText
        end
    end)
end

local function teleportRootToCFrame(targetCFrame)
    local root = getRoot()
    if not root then
        return false
    end

    root.CFrame = targetCFrame
    return true
end

local function getClosestChestPrompt()
    local root = getRoot()
    if not root then
        return nil, nil, math.huge
    end

    local closestPrompt = nil
    local closestAdornee = nil
    local closestDistance = math.huge

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and isOpenChestPrompt(obj) then
            local adornee = getAdorneeFromPrompt(obj)
            if adornee then
                local distance = (adornee.Position - root.Position).Magnitude
                if distance < closestDistance then
                    closestDistance = distance
                    closestPrompt = obj
                    closestAdornee = adornee
                end
            end
        end
    end

    return closestPrompt, closestAdornee, closestDistance
end

local function tpToClosestChest()
    local _, chestPart = getClosestChestPrompt()
    if not chestPart then
        return false
    end

    return teleportRootToCFrame(CFrame.new(chestPart.Position + Vector3.new(0, 3, 0)))
end

local function tpToRaft()
    return teleportRootToCFrame(RaftCFrame)
end

local DOUBLOONS_CHEST_MESH_ID = "91191648141105"
local DoubloonsChestCache = {}
local DoubloonsChestVisited = {}
local DoubloonsCacheReady = false
local DoubloonsLastFullScan = 0
local DoubloonsFullScanCooldown = 8

local function normalizeMeshId(id)
    id = tostring(id or "")
    return id:match("%d+") or id
end

local function getPartFromMeshObject(obj)
    if obj:IsA("MeshPart") then
        return obj
    end

    if obj:IsA("SpecialMesh") and obj.Parent and obj.Parent:IsA("BasePart") then
        return obj.Parent
    end

    return nil
end

local function isDoubloonsMeshObject(obj)
    local meshId = nil

    if obj:IsA("MeshPart") then
        meshId = obj.MeshId
    elseif obj:IsA("SpecialMesh") then
        meshId = obj.MeshId
    end

    return meshId and normalizeMeshId(meshId) == DOUBLOONS_CHEST_MESH_ID
end

local function addDoubloonsChestToCache(obj)
    if not isDoubloonsMeshObject(obj) then
        return
    end

    local part = getPartFromMeshObject(obj)
    if not part then
        return
    end

    for _, cachedPart in ipairs(DoubloonsChestCache) do
        if cachedPart == part then
            return
        end
    end

    table.insert(DoubloonsChestCache, part)
end

local function refreshDoubloonsChestCache(force)
    if not force and tick() - DoubloonsLastFullScan < DoubloonsFullScanCooldown then
        return
    end

    DoubloonsLastFullScan = tick()
    DoubloonsChestCache = {}

    -- Pakai Workspace saja biar tidak scan semua CoreGui/ReplicatedStorage dan mengurangi lag.
    for _, obj in ipairs(Workspace:GetDescendants()) do
        addDoubloonsChestToCache(obj)
    end

    DoubloonsCacheReady = true
end

Workspace.DescendantAdded:Connect(function(obj)
    task.defer(function()
        addDoubloonsChestToCache(obj)
    end)
end)

-- Scan awal dibuat di background supaya tidak nge-freeze saat tombol pertama ditekan.
task.spawn(function()
    task.wait(1)
    refreshDoubloonsChestCache(true)
end)

local function getVisitedKey(part)
    if not part then
        return nil
    end

    -- Key pakai posisi + nama supaya chest yang sudah pernah di-TP tidak dipilih lagi.
    local pos = part.Position
    return part:GetFullName() .. "|" .. math.floor(pos.X) .. "," .. math.floor(pos.Y) .. "," .. math.floor(pos.Z)
end

local function tpToDoubloonsChest()
    local root = getRoot()
    if not root then
        return false, "No Character"
    end

    if not DoubloonsCacheReady then
        refreshDoubloonsChestCache(true)
    else
        refreshDoubloonsChestCache(false)
    end

    local nearestPart = nil
    local nearestDistance = math.huge

    for i = #DoubloonsChestCache, 1, -1 do
        local part = DoubloonsChestCache[i]

        if not part or not part.Parent then
            table.remove(DoubloonsChestCache, i)
        else
            local visitedKey = getVisitedKey(part)

            if not DoubloonsChestVisited[visitedKey] then
                local distance = (root.Position - part.Position).Magnitude

                if distance < nearestDistance then
                    nearestDistance = distance
                    nearestPart = part
                end
            end
        end
    end

    if nearestPart then
        local visitedKey = getVisitedKey(nearestPart)
        if visitedKey then
            DoubloonsChestVisited[visitedKey] = true
        end

        local humanoid = getHumanoid()
        if humanoid then
            humanoid.Sit = false
            humanoid.PlatformStand = false
        end

        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        root.CFrame = CFrame.new(nearestPart.Position + Vector3.new(0, 6, 0))

        print("Teleport ke Doubloons Chest:", nearestPart:GetFullName())
        return true, "Teleported"
    end

    warn("Doubloons Chest baru tidak ditemukan / semua sudah pernah di-TP")
    return false, "All Visited"
end

-- Input
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == Enum.KeyCode.W then
        flyingKeys.W = true
    elseif input.KeyCode == Enum.KeyCode.A then
        flyingKeys.A = true
    elseif input.KeyCode == Enum.KeyCode.S then
        flyingKeys.S = true
    elseif input.KeyCode == Enum.KeyCode.D then
        flyingKeys.D = true
    elseif input.KeyCode == Enum.KeyCode.Space then
        flyingKeys.Space = true
    elseif input.KeyCode == Enum.KeyCode.LeftControl then
        flyingKeys.LeftControl = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then
        flyingKeys.W = false
    elseif input.KeyCode == Enum.KeyCode.A then
        flyingKeys.A = false
    elseif input.KeyCode == Enum.KeyCode.S then
        flyingKeys.S = false
    elseif input.KeyCode == Enum.KeyCode.D then
        flyingKeys.D = false
    elseif input.KeyCode == Enum.KeyCode.Space then
        flyingKeys.Space = false
    elseif input.KeyCode == Enum.KeyCode.LeftControl then
        flyingKeys.LeftControl = false
    end
end)

player.CharacterAdded:Connect(function()
    if FlyEnabled then
        task.wait(1)
        stopFly()
        task.wait(0.2)
        startFly()
    end
end)

-- Fly Slider
local draggingSlider = false

local function updateSlider(inputX)
    local sliderPosition = sliderBack.AbsolutePosition.X
    local sliderSize = sliderBack.AbsoluteSize.X
    local percent = math.clamp((inputX - sliderPosition) / sliderSize, 0, 1)

    FlySpeed = math.floor(percent * 200)
    if FlySpeed < 1 then
        FlySpeed = 1
    end

    sliderFill.Size = UDim2.new(percent, 0, 1, 0)
    sliderKnob.Position = UDim2.new(percent, -8, 0.5, -8)
    speedText.Text = "Fly Speed: " .. tostring(FlySpeed)
end

sliderKnob.MouseButton1Down:Connect(function()
    draggingSlider = true
end)

sliderBack.InputBegan:Connect(function(input)
    if isPressInput(input) then
        draggingSlider = true
        updateSlider(input.Position.X)
    end
end)

-- Chest Stud Slider
local draggingChestSlider = false
local draggingCombatSlider = false

local function updateChestSlider(inputX)
    local sliderPosition = chestSliderBack.AbsolutePosition.X
    local sliderSize = chestSliderBack.AbsoluteSize.X
    local percent = math.clamp((inputX - sliderPosition) / sliderSize, 0, 1)

    ChestESPMaxStud = math.floor(percent * 1000)
    if ChestESPMaxStud < 1 then
        ChestESPMaxStud = 1
    end

    chestSliderFill.Size = UDim2.new(percent, 0, 1, 0)
    chestSliderKnob.Position = UDim2.new(percent, -8, 0.5, -8)
    chestStudText.Text = "Chest Stud: " .. tostring(ChestESPMaxStud)
end

chestSliderKnob.MouseButton1Down:Connect(function()
    draggingChestSlider = true
end)

chestSliderBack.InputBegan:Connect(function(input)
    if isPressInput(input) then
        draggingChestSlider = true
        updateChestSlider(input.Position.X)
    end
end)


local function updateCombatSlider(inputX)
    local sliderPosition = combatSliderBack.AbsolutePosition.X
    local sliderSize = combatSliderBack.AbsoluteSize.X
    local percent = math.clamp((inputX - sliderPosition) / sliderSize, 0, 1)

    AutoKillRadius = math.floor(percent * 500)
    if AutoKillRadius < 1 then
        AutoKillRadius = 1
    end

    combatSliderFill.Size = UDim2.new(percent, 0, 1, 0)
    combatSliderKnob.Position = UDim2.new(percent, -8, 0.5, -8)
    combatRadiusText.Text = "Kill Radius: " .. tostring(AutoKillRadius)
end

combatSliderKnob.MouseButton1Down:Connect(function()
    draggingCombatSlider = true
end)

combatSliderBack.InputBegan:Connect(function(input)
    if isPressInput(input) then
        draggingCombatSlider = true
        updateCombatSlider(input.Position.X)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if isPressInput(input) then
        draggingSlider = false
        draggingChestSlider = false
        draggingCombatSlider = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isMoveInput(input) then
        if draggingSlider then
            updateSlider(input.Position.X)
        end

        if draggingChestSlider then
            updateChestSlider(input.Position.X)
        end

        if draggingCombatSlider then
            updateCombatSlider(input.Position.X)
        end
    end
end)

-- Full Bright + No Fog
local FullBrightEnabled = false
local NoFogEnabled = false

local SavedLighting = {
    Brightness = Lighting.Brightness,
    ClockTime = Lighting.ClockTime,
    FogEnd = Lighting.FogEnd,
    FogStart = Lighting.FogStart,
    GlobalShadows = Lighting.GlobalShadows,
    Ambient = Lighting.Ambient,
    OutdoorAmbient = Lighting.OutdoorAmbient
}

local LightingConnection = nil

local function saveLightingOnce()
    SavedLighting.Brightness = Lighting.Brightness
    SavedLighting.ClockTime = Lighting.ClockTime
    SavedLighting.FogEnd = Lighting.FogEnd
    SavedLighting.FogStart = Lighting.FogStart
    SavedLighting.GlobalShadows = Lighting.GlobalShadows
    SavedLighting.Ambient = Lighting.Ambient
    SavedLighting.OutdoorAmbient = Lighting.OutdoorAmbient
end

local function applyVisualLighting()
    if FullBrightEnabled then
        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
    end

    if NoFogEnabled then
        Lighting.FogStart = 0
        Lighting.FogEnd = 100000
    end
end

local function startLightingLoop()
    if LightingConnection then
        LightingConnection:Disconnect()
        LightingConnection = nil
    end

    LightingConnection = RunService.RenderStepped:Connect(function()
        if FullBrightEnabled or NoFogEnabled then
            applyVisualLighting()
        end
    end)
end

local function stopLightingLoopIfUnused()
    if not FullBrightEnabled and not NoFogEnabled then
        if LightingConnection then
            LightingConnection:Disconnect()
            LightingConnection = nil
        end
    end
end

local function enableFullBright()
    if not FullBrightEnabled and not NoFogEnabled then
        saveLightingOnce()
    end

    FullBrightEnabled = true
    applyVisualLighting()
    startLightingLoop()
end

local function disableFullBright()
    FullBrightEnabled = false

    Lighting.Brightness = SavedLighting.Brightness
    Lighting.ClockTime = SavedLighting.ClockTime
    Lighting.GlobalShadows = SavedLighting.GlobalShadows
    Lighting.Ambient = SavedLighting.Ambient
    Lighting.OutdoorAmbient = SavedLighting.OutdoorAmbient

    if NoFogEnabled then
        applyVisualLighting()
    end

    stopLightingLoopIfUnused()
end

local function enableNoFog()
    if not FullBrightEnabled and not NoFogEnabled then
        saveLightingOnce()
    end

    NoFogEnabled = true
    applyVisualLighting()
    startLightingLoop()
end

local function disableNoFog()
    NoFogEnabled = false

    Lighting.FogStart = SavedLighting.FogStart
    Lighting.FogEnd = SavedLighting.FogEnd

    if FullBrightEnabled then
        applyVisualLighting()
    end

    stopLightingLoopIfUnused()
end

