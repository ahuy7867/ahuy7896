if CoreGui:FindFirstChild("CihuyUI") then
    CoreGui.CihuyUI:Destroy()
end

local gui = Instance.new("ScreenGui")
gui.Name = "CihuyUI"
gui.ResetOnSpawn = false
gui.Parent = CoreGui

local function makeCorner(obj, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 8)
    corner.Parent = obj
    return corner
end

local function makeButton(parent, name, text, pos)
    local button = Instance.new("TextButton")
    button.Name = name
    button.Size = UDim2.new(0, 180, 0, 34)
    button.Position = pos
    button.BackgroundColor3 = Color3.fromRGB(170, 50, 50)
    button.Text = text
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextSize = 12
    button.Font = Enum.Font.GothamBold
    button.Parent = parent
    makeCorner(button, 8)
    return button
end

local function setButtonState(button, text, state)
    button.Text = text
    button.BackgroundColor3 = state and Color3.fromRGB(50, 170, 80) or Color3.fromRGB(170, 50, 50)
end

