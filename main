local function bindHoldButton(button, setFunc)
    button.InputBegan:Connect(function(input)
        if isPressInput(input) then
            setFunc(true)
        end
    end)

    button.InputEnded:Connect(function(input)
        if isPressInput(input) then
            setFunc(false)
        end
    end)
end

bindHoldButton(mobileUpButton, function(state)
    MobileFlyUp = state
end)

bindHoldButton(mobileDownButton, function(state)
    MobileFlyDown = state
end)

