local miniOpenButton = Instance.new("TextButton")
miniOpenButton.Name = "MiniOpenButton"
miniOpenButton.Size = UDim2.new(0, 62, 0, 30)
miniOpenButton.Position = UDim2.new(0.5, -31, 1, -44)
